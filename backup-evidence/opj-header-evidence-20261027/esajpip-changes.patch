+static OPJ_SIZE_T read_bytes(void *bytes, OPJ_SIZE_T size, void *user) {
+    output *in = user;
+    if (in->at == in->size) return (OPJ_SIZE_T)-1;
+    if (size > in->size - in->at) size = in->size - in->at;
+    memcpy(bytes, in->data + in->at, size);
+    in->at += size;
+    return size;
+}
